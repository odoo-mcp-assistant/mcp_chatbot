<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- Snippet definition                                           -->
    <!-- ============================================================ -->
    <template id="snippet_mcp_chatbot" name="MCP AI Chatbot">
        <section class="s_mcp_chatbot"
                 data-snippet="s_mcp_chatbot"
                 data-name="MCP AI Chatbot"
                 data-drop-in=".odoo-editor-editable, #wrapwrap"
                 data-drop-near="section, .s_mcp_chatbot">

            <!-- ── Chat bubble trigger ──────────────────────────── -->
            <div id="mcp_chatbot_bubble" class="mcp-chatbot-bubble" title="Chat with us">
                <img src="/mcp_chatbot/static/src/img/ai-logo.jpeg"
                    alt="Chat"
                    style="width: 100%; height: 100%; object-fit: cover; display: block; transform: scale(1.2); transform-origin: center;"/>
            </div>

            <!-- ── Bubble hover tooltip ────────────────────────── -->
            <div id="mcp_chatbot_bubble_tooltip" class="mcp-chatbot-bubble-tooltip">
                <span>Hi, I&#x2019;m <strong id="mcp_chatbot_tooltip_name">AI Assistant</strong>,<br/>your AI assistant.</span>
                <div class="mcp-chatbot-bubble-tooltip-arrow"></div>
            </div>

            <!-- ── Chat window ──────────────────────────────────── -->
            <div id="mcp_chatbot_window" class="mcp-chatbot-window d-none">

                <!-- Header -->
                <div class="mcp-chatbot-header">
                    <div class="mcp-chatbot-header-identity">
                        <img class="mcp-chatbot-header-logo"
                             src="/mcp_chatbot/static/src/img/ai-logo.jpeg"
                             alt="Bot"/>
                        <div class="mcp-chatbot-header-info">
                            <span id="mcp_chatbot_title" class="mcp-chatbot-title">AI Assistant</span>
                            <span class="mcp-chatbot-status">Offline</span>
                        </div>
                    </div>
                    <div class="mcp-chatbot-header-actions">
                        <button class="mcp-chatbot-expand" title="Expand">
                            <i class="fa fa-expand"/>
                        </button>
                        <button class="mcp-chatbot-close" title="Minimize">
                            <i class="fa fa-minus"/>
                        </button>
                        <button class="mcp-chatbot-end-session" title="End session">
                            <i class="fa fa-times"/>
                        </button>
                    </div>
                </div>

                <!-- End session confirmation overlay -->
                <div class="mcp-chatbot-confirm-overlay d-none">
                    <div class="mcp-chatbot-confirm-dialog">
                        <p>How was your experience?</p>
                        <div class="mcp-chatbot-confirm-subtitle">Your feedback helps us improve</div>
                        <div class="mcp-chatbot-rating-faces">
                            <button class="mcp-chatbot-face mcp-face-bad" data-rating="bad" title="Bad">
                                <i class="fa fa-frown-o"/>
                            </button>
                            <button class="mcp-chatbot-face mcp-face-neutral" data-rating="neutral" title="Neutral">
                                <i class="fa fa-meh-o"/>
                            </button>
                            <button class="mcp-chatbot-face mcp-face-good" data-rating="good" title="Good">
                                <i class="fa fa-smile-o"/>
                            </button>
                        </div>
                        <textarea class="mcp-chatbot-feedback" placeholder="Tell us more (optional)..." rows="4"/>
                        <div class="mcp-chatbot-confirm-actions">
                            <button class="mcp-chatbot-confirm-no">Cancel</button>
                            <button class="mcp-chatbot-confirm-yes">End Session</button>
                        </div>
                    </div>
                </div>

                <!-- Message area -->
                <div id="mcp_chatbot_messages" class="mcp-chatbot-messages">
                    <!-- Messages are injected by chatbot_widget.js -->
                </div>

                <!-- Scroll-to-bottom button -->
                <button id="mcp_chatbot_scroll_bottom" class="mcp-chatbot-scroll-bottom d-none" aria-label="Scroll to bottom">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
                </button>

                <!-- Input area -->
                <div class="mcp-chatbot-input-area">
                    <div class="mcp-chatbot-input-wrapper">
                        <textarea id="mcp_chatbot_input"
                                  class="mcp-chatbot-input"
                                  placeholder="Type your message..."
                                  rows="1"
                                  autocomplete="off"/>
                        <div class="mcp-chatbot-input-actions">
                            <button id="mcp_chatbot_send" class="mcp-chatbot-send" title="Send">
                                <i class="fa fa-arrow-up"/>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Suggestion chips — authenticated users -->
                <div id="mcp_chatbot_suggestions_auth" class="mcp-chatbot-suggestions mcp-suggestions-auth">
                    <button class="mcp-chatbot-suggestion" data-query="Show me my orders">
                        <i class="fa fa-shopping-bag"/>
                        <span>My orders</span>
                    </button>
                    <button class="mcp-chatbot-suggestion" data-query="Show me my invoices">
                        <i class="fa fa-file-text-o"/>
                        <span>My invoices</span>
                    </button>
                    <button class="mcp-chatbot-suggestion" data-query="Show me my unpaid invoices">
                        <i class="fa fa-exclamation-circle"/>
                        <span>Unpaid</span>
                    </button>
                </div>

                <!-- Suggestion chips — anonymous visitors -->
                <div id="mcp_chatbot_suggestions_anon" class="mcp-chatbot-suggestions mcp-suggestions-anon">
                    <button class="mcp-chatbot-suggestion" data-query="Show me your product catalogue">
                        <i class="fa fa-tags"/>
                        <span>Products</span>
                    </button>
                    <button class="mcp-chatbot-suggestion" data-query="Tell me about your installment payment options">
                        <i class="fa fa-credit-card"/>
                        <span>Installments</span>
                    </button>
                    <button class="mcp-chatbot-suggestion" data-query="What are your delivery options?">
                        <i class="fa fa-truck"/>
                        <span>Delivery</span>
                    </button>
                </div>

                <!-- AI disclaimer -->
                <div class="mcp-chatbot-disclaimer">
                    <span id="mcp_chatbot_disclaimer_name">AI Assistant</span> can make mistakes. Check important info.
                </div>

            </div>
        </section>
    </template>

    <!-- ============================================================ -->
    <!-- Register snippet in the Website Builder (Odoo 18)            -->
    <!-- ============================================================ -->
    <template id="snippets_mcp_chatbot" inherit_id="website.snippets" name="MCP Chatbot Snippet">
        <xpath expr="//snippets[@id='snippet_groups']//t[@snippet-group][last()]" position="before">
            <t t-snippet="mcp_chatbot.snippet_mcp_chatbot"
               string="MCP AI Chatbot"
               t-thumbnail="/mcp_chatbot/static/src/img/chatbot_icon">
                <keywords>chatbot, chat, ai, assistant, mcp</keywords>
            </t>
        </xpath>
    </template>

</odoo>
