<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="inherit_res_partner_view_form" model="ir.ui.view">
        <field name="name">inherit.res.partner.view.form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">

            <xpath expr="//page[@name='internal_notes']" position="before">

                <page name="user_mcp_chatbot_sessions" string="Chatbot Sessions">
                    <field name="chatbot_session_ids">
                        <list>
                            <field name="name"/>
                            <field name="message_count"/>
                            <field name="last_activity"/>
                            <field name="state"/>
                            <field name="create_date"/>
                        </list>
                    </field>
                </page>

                <page name="user_facts" string="User Facts">
                    <field name="user_fact_ids">
                        <list>
                            <field name="fact_text"/>
                            <field name="category"/>
                            <field name="create_date"/>
                        </list>
                    </field>
                </page>

            </xpath>

        </field>
    </record>

</odoo>
