<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- Settings form view (inherits base settings)                  -->
    <!-- ============================================================ -->
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">
            res.config.settings.view.form.inherit.mcp.chatbot
        </field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="15"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="MCP Chatbot"
                     string="MCP Chatbot"
                     name="mcp_chatbot"
                     logo="/mcp_chatbot/static/src/img/ai-logo.jpeg">

                    <!-- General -->
                    <block title="General"
                           name="mcp_chatbot_general">
                        <setting string="Chatbot Name"
                                 help="The display name of the chatbot shown to customers."
                                 id="chatbot_bot_name_setting">
                            <field name="chatbot_bot_name"/>
                        </setting>
                        <setting string="Status"
                                 help="Set to Offline to disable the chat widget — visitors will see an Offline badge and cannot send messages."
                                 id="chatbot_status_setting">
                            <field name="chatbot_status"/>
                        </setting>
                    </block>

                    <!-- LLM Configuration -->
                    <block title="LLM Configuration"
                           name="mcp_chatbot_llm">
                        <setting string="API Key"
                                 help="Groq API key used to authenticate LLM requests."
                                 id="chatbot_api_key_setting">
                            <field name="chatbot_api_key" style="width: 100%;"/>
                        </setting>
                        <setting string="Base URL"
                                 help="Base URL for the LLM API."
                                 id="chatbot_base_url_setting">
                            <field name="chatbot_base_url" style="width: 100%;"/>
                        </setting>
                        <setting string="LLM Provider"
                                 help="Filter the model list to a specific provider."
                                 id="chatbot_llm_provider_setting">
                            <field name="chatbot_llm_provider_id"/>
                        </setting>
                        <setting string="LLM Model"
                                 help="The language model used to generate chatbot responses."
                                 id="chatbot_llm_model_setting">
                            <field name="chatbot_llm_model_id"
                                   domain="[('provider_id', '=', chatbot_llm_provider_id)]"/>
                        </setting>
                        <setting string="System Prompt"
                                 help="The system prompt sent to the LLM on every conversation."
                                 id="chatbot_system_prompt_setting">
                            <field name="chatbot_system_prompt"
                                   widget="text"
                                   style="width: 100%;"/>
                        </setting>
                        <setting string="Max Tool Rounds"
                                 help="Maximum number of tool-calling rounds per message. Default is 5."
                                 id="chatbot_max_tool_rounds_setting">
                            <field name="chatbot_max_tool_rounds"/>
                        </setting>
                    </block>

                    <!-- RAG -->
                    <block title="RAG"
                           name="mcp_chatbot_rag">
                        <setting string="Fact Extraction API Key"
                                 help="API key used exclusively for the fact extraction LLM. Falls back to the main API key if left empty."
                                 id="chatbot_fact_extraction_api_key_setting">
                            <field name="chatbot_fact_extraction_api_key" style="width: 100%;"/>
                        </setting>
                        <setting string="Fact Extraction Base URL"
                                 help="Base URL for the fact extraction LLM API. Falls back to the main Base URL if left empty."
                                 id="chatbot_fact_extraction_base_url_setting">
                            <field name="chatbot_fact_extraction_base_url" style="width: 100%;"/>
                        </setting>
                        <setting string="Fact Extraction Provider"
                                 help="Filter the fact extraction model list to a specific provider."
                                 id="chatbot_fact_extraction_provider_setting">
                            <field name="chatbot_fact_extraction_provider_id"/>
                        </setting>
                        <setting string="Fact Extraction Model"
                                 help="The language model used to extract long-term memory facts from conversations."
                                 id="chatbot_fact_extraction_model_setting">
                            <field name="chatbot_fact_extraction_model_id"
                                   domain="[('provider_id', '=', chatbot_fact_extraction_provider_id)]"/>
                        </setting>
                        <setting string="RAG System Prompt"
                                 help="System prompt used by the fact extraction model."
                                 id="chatbot_rag_system_prompt_setting"
                                 colspan="2">
                            <div class="col-12">
                                <field name="chatbot_rag_system_prompt"
                                    widget="text"
                                    style="width: 100%;"/>
                            </div>
                        </setting>
                        
                    </block>

                    <!-- Summary -->
                    <block title="Summary"
                           name="mcp_chatbot_summary">
                        <setting string="Summary API Key"
                                 help="API key used exclusively for the summary LLM. Falls back to the main API key if left empty."
                                 id="chatbot_summary_api_key_setting">
                            <field name="chatbot_summary_api_key" style="width: 100%;"/>
                        </setting>
                        <setting string="Summary Base URL"
                                 help="Base URL for the summary LLM API. Falls back to the main Base URL if left empty."
                                 id="chatbot_summary_base_url_setting">
                            <field name="chatbot_summary_base_url" style="width: 100%;"/>
                        </setting>
                        <setting string="Summary Provider"
                                 help="Filter the summary model list to a specific provider."
                                 id="chatbot_summary_provider_setting">
                            <field name="chatbot_summary_provider_id"/>
                        </setting>
                        <setting string="Summary Model"
                                 help="The language model used to summarize conversation history. Falls back to the main LLM model if not set."
                                 id="chatbot_summary_model_setting">
                            <field name="chatbot_summary_model_id"
                                   domain="[('provider_id', '=', chatbot_summary_provider_id)]"/>
                        </setting>
                    </block>

                    <!-- MCP Server -->
                    <block title="MCP Server"
                           name="mcp_chatbot_mcp">
                        <setting string="MCP Server URL"
                                 help="URL of the MCP server."
                                 id="chatbot_mcp_server_url_setting">
                            <field name="chatbot_mcp_server_url" style="width: 100%;"/>
                        </setting>
                    </block>

                    <!-- Session Management -->
                    <block title="Session Management"
                           name="mcp_chatbot_session">
                        <setting string="Idle Timeout (minutes)"
                                 help="Minutes of inactivity before a session is automatically closed. Default is 30."
                                 id="chatbot_idle_timeout_setting">
                            <field name="chatbot_idle_timeout"/>
                        </setting>
                        <setting string="Summary Token Threshold"
                                 help="Estimated token count of unsummarized messages before triggering history summarization. Default is 2000."
                                 id="chatbot_summary_interval_setting">
                            <field name="chatbot_summary_interval"/>
                        </setting>
                    </block>

                </app>
            </xpath>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Window action                                                 -->
    <!-- ============================================================ -->
    <record id="res_config_settings_action" model="ir.actions.act_window">
        <field name="name">Configuration</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module': 'mcp_chatbot'}</field>
    </record>

    <!-- ============================================================ -->
    <!-- Settings menu item                                            -->
    <!-- ============================================================ -->
    <menuitem id="menu_mcp_chatbot_settings"
              name="Settings"
              parent="mcp_chatbot.menu_mcp_chatbot_configuration"
              action="mcp_chatbot.res_config_settings_action"
              sequence="30"
              groups="base.group_system"/>

</odoo>