<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- List view                                                      -->
    <!-- ============================================================ -->
    <record id="view_mcp_chatbot_user_fact_list" model="ir.ui.view">
        <field name="name">mcp.chatbot.user.fact.list</field>
        <field name="model">mcp.chatbot.user.fact</field>
        <field name="arch" type="xml">
            <list string="User Facts" default_order="create_date desc">
                <field name="partner_id"/>
                <field name="fact_text"/>
                <field name="category"/>
                <field name="create_date" string="Saved At"/>
            </list>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Form view                                                      -->
    <!-- ============================================================ -->
    <record id="view_mcp_chatbot_user_fact_form" model="ir.ui.view">
        <field name="name">mcp.chatbot.user.fact.form</field>
        <field name="model">mcp.chatbot.user.fact</field>
        <field name="arch" type="xml">
            <form string="User Fact">
                <sheet>
                    <group>
                        <group string="Owner">
                            <field name="partner_id"/>
                            <field name="category"/>
                            <field name="create_date" string="Saved At"/>
                        </group>
                    </group>
                    <group string="Fact Content">
                        <field name="fact_text" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Window action                                                  -->
    <!-- ============================================================ -->
    <record id="action_mcp_chatbot_user_facts" model="ir.actions.act_window">
        <field name="name">User Facts</field>
        <field name="res_model">mcp.chatbot.user.fact</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
