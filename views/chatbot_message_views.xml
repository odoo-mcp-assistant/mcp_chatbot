<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- Message list view                                             -->
    <!-- ============================================================ -->
    <record id="view_mcp_chatbot_message_list" model="ir.ui.view">
        <field name="name">mcp.chatbot.message.list</field>
        <field name="model">mcp.chatbot.message</field>
        <field name="arch" type="xml">
            <list string="Chatbot Messages">
                <field name="create_date" string="Time"/>
                <field name="session_id"/>
                <field name="role"/>
                <field name="content"/>
            </list>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Message form view                                             -->
    <!-- ============================================================ -->
    <record id="view_mcp_chatbot_message_form" model="ir.ui.view">
        <field name="name">mcp.chatbot.message.form</field>
        <field name="model">mcp.chatbot.message</field>
        <field name="arch" type="xml">
            <form string="Chatbot Message">
                <sheet>
                    <group>
                        <group string="Context">
                            <field name="session_id"/>
                            <field name="role"/>
                            <field name="create_date" string="Sent at" readonly="1"/>
                        </group>
                    </group>
                    <group string="Content">
                        <field name="content" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Action                                                        -->
    <!-- ============================================================ -->
    <record id="action_mcp_chatbot_messages" model="ir.actions.act_window">
        <field name="name">Chatbot Messages</field>
        <field name="res_model">mcp.chatbot.message</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
